# ==============================================================================
# Backend Environment Configuration - Intelligent Cloud Auto-Scaling
# ==============================================================================

# Application Settings
PROJECT_NAME="Intelligent Cloud Auto-Scaling Backend"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false
PORT=8000

# ------------------------------------------------------------------------------
# Database Settings (Amazon RDS & SQLite)
# ------------------------------------------------------------------------------
# Set USE_SQLITE=true for local zero-dependency development without AWS credentials.
# Set USE_SQLITE=false to connect to Amazon RDS (PostgreSQL or MySQL).
USE_SQLITE=true
SQLITE_PATH="cloud_autoscaling.db"

# Amazon RDS PostgreSQL / MySQL Production Credentials
# Example: postgresql+psycopg2://db_user:StrongPassword123@ecommerce-scaling-rds.c3xxxx.us-east-1.rds.amazonaws.com:5432/ecommerce_db
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=
DB_PASSWORD=
DB_SSL_MODE=require

# High-Concurrency Connection Pooling (Tuned for Festival Flash Sales)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
SECRET_KEY=
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ------------------------------------------------------------------------------
# AI / Reinforcement Learning Service Integration (Arpita's Module)
# ------------------------------------------------------------------------------
# URL of the hosted RL inference microservice (e.g. AWS SageMaker / EC2 endpoint)
# Leave empty to use the built-in intelligent heuristic fallback policy.
AI_SERVICE_URL=
AI_TIMEOUT_SECONDS=3.0
SCALING_POLICY=q_learning
# Set SCALING_POLICY=ppo_candidate only for explicitly labeled evaluation.
# PPO_MODEL_PATH=models/best_ppo_model.zip

# ------------------------------------------------------------------------------
# AWS Auto Scaling Group Integration (Arpita's Cloud Infra)
# ------------------------------------------------------------------------------
# AWS mock mode is the safe local default. Live AWS access requires explicit
# deployment configuration. Capacity writes remain disabled by all gates below.
AWS_MOCK_MODE=true
AWS_LIVE_SCALING_ENABLED=false
AWS_LIVE_SCALING_PERMISSION_CONFIRMED=false
AWS_REGION=ap-south-1
AWS_ASG_NAME=rl-autoscaling-group
AWS_EXPECTED_ACCOUNT_ID=
AWS_EXPECTED_LAUNCH_TEMPLATE=autoscaling-launch-template
AWS_EXPECTED_MIN_SIZE=1
AWS_EXPECTED_MAX_SIZE=3
# Read-only data plane checks. Keep every live-write gate false by default.
AWS_ALB_NAME=autoscaling-alb
AWS_TARGET_GROUP_NAME=rl-target-group
AWS_CLOUDWATCH_PERIOD_SECONDS=300
AWS_CLOUDWATCH_MAX_AGE_SECONDS=900
AWS_SCALING_COOLDOWN_SECONDS=300
# Optional named AWS CLI profile; otherwise boto3 uses its standard role/profile
# credential chain. Do not put access keys in this file.
AWS_PROFILE=

# Signed workload replay callback. Inject the secret securely at runtime.
WORKLOAD_REPLAY_HMAC_SECRET=
WORKLOAD_REPLAY_MAX_SKEW_SECONDS=300
WORKLOAD_REPLAY_ALLOW_LIVE_SCALING=false
